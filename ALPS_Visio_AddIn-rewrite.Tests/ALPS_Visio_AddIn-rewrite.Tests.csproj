<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <RootNamespace>ALPS_Visio_AddIn_rewrite.Tests</RootNamespace>
    <AssemblyName>ALPS_Visio_AddIn-rewrite.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="alps.net.api" Version="0.9.1.7" />
    <PackageReference Include="coverlet.collector" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ALPS_Visio_AddIn-rewrite\ALPS_Visio_AddIn-rewrite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\docs\[Test]_ALPS_Verification_Specification.owl">
      <Link>Fixtures\[Test]_ALPS_Verification_Specification.owl</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\docs\[Test]_ALPS_Verification_Implementation.owl">
      <Link>Fixtures\[Test]_ALPS_Verification_Implementation.owl</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\docs\[Test]_Vacation_Request.owl">
      <Link>Fixtures\[Test]_Vacation_Request.owl</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="coverlet.runsettings" />
  </ItemGroup>
</Project>
